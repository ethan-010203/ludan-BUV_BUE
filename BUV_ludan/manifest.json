{
  "manifest_version": 3,
  "name": "Document Checker",
  "version": "1.0.0",
  "description": "Check uploaded folder documents against country/registration requirements. Sidebar with AI detection and autofill.",
  "action": {
    "default_title": "Document Checker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "sidePanel", "activeTab", "scripting", "tabs"],
  "host_permissions": ["https://api.moonshot.cn/*", "http://*/*", "https://*/*"]
}
